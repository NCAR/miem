FROM docker.io/intel/oneapi-hpckit:latest

RUN apt update \
    && apt -y install \
      build-essential \
      ca-certificates \
      cmake \
      cmake-curses-gui \
      git \
      libnetcdf-dev \
      make \
    && apt clean

ENV CC=icx
ENV CXX=icpx

COPY . /miem/

RUN mkdir /build \
    && cd /build \
    && cmake \
        -D CMAKE_BUILD_TYPE=Release \
        -D MIEM_ENABLE_TESTS=ON \
        /miem \
    && make -j 8

WORKDIR /build
